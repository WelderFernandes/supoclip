# =============================================================================
# SupoClip — .env de PRODUÇÃO (template)
# =============================================================================
# Copie para `.env` e preencha. NÃO use os valores de exemplo em produção.
#
# Na Dokploy: cole este conteúdo no painel "Environment" do serviço Compose.
# A Dokploy grava um `.env` ao lado do docker-compose.dokploy.yml, que lê os
# valores via sintaxe ${VAR}.
#
# Substitua TODAS as ocorrências de `seudominio.com` pelo seu domínio real.
# =============================================================================


# -----------------------------------------------------------------------------
# [1] DOMÍNIOS  ← preencha primeiro
# -----------------------------------------------------------------------------
# Você precisa de DOIS subdomínios apontados (registros A) para a VPS:
#   supoclip.seudominio.com  -> frontend (porta interna 3107)
#   api.seudominio.com       -> backend  (porta interna 8000)
#
# Por que o backend precisa de domínio público: com BACKEND_AUTH_SECRET
# definido, o NAVEGADOR envia o vídeo direto para NEXT_PUBLIC_API_URL. Sem um
# backend público, upload de arquivo não funciona.
# (Fonte: frontend/src/components/articles/self-hosting-guide-article.tsx)

NEXT_PUBLIC_APP_URL=https://supoclip.seudominio.com
BETTER_AUTH_URL=https://supoclip.seudominio.com
NEXT_PUBLIC_API_URL=https://api.seudominio.com

# Origens de navegador autorizadas. Precisa conter o frontend, senão login
# falha com "Invalid Origin" e o upload direto bate em CORS.
CORS_ORIGINS=https://supoclip.seudominio.com
BETTER_AUTH_TRUSTED_ORIGINS=


# -----------------------------------------------------------------------------
# [2] SEGREDOS  ← gere novos, não reutilize os de desenvolvimento
# -----------------------------------------------------------------------------
# Gere cada um com:  openssl rand -hex 32

# Sem estes três, o app não sobe em produção.
BETTER_AUTH_SECRET=TROQUE_ME_openssl_rand_hex_32
BACKEND_AUTH_SECRET=TROQUE_ME_openssl_rand_hex_32
# CUIDADO: se você mudar esta chave depois, as configurações já cifradas no
# banco ficam ilegíveis. Defina uma vez e guarde com segurança.
APP_SETTINGS_ENCRYPTION_KEY=TROQUE_ME_openssl_rand_hex_32

# Senha do Postgres. Era hardcoded (`supoclip_password`) no compose original,
# em quatro lugares. No docker-compose.dokploy.yml ela é parametrizada, então
# basta definir aqui. Use hex para não precisar de escape dentro da URL:
#   openssl rand -hex 24
POSTGRES_PASSWORD=TROQUE_ME_openssl_rand_hex_24

# Senha do Redis. Vazio = sem AUTH. Defina em produção.
REDIS_PASSWORD=TROQUE_ME_openssl_rand_hex_24


# -----------------------------------------------------------------------------
# [3] MODO
# -----------------------------------------------------------------------------
# true = open-source / self-host (sem monetização). Mantenha true.
SELF_HOST=true
# true = bloqueia novos cadastros. Recomendado se for só para você/seu time.
DISABLE_SIGN_UP=true
NEXT_PUBLIC_LANDING_ONLY_MODE=false
ALLOW_UNSIGNED_BACKEND_AUTH=false
AUTH_SIGNATURE_TTL_SECONDS=300


# -----------------------------------------------------------------------------
# [4] TRANSCRIÇÃO
# -----------------------------------------------------------------------------
# assemblyai (nuvem, precisa de chave) | whisper (local, lento em CPU)
# | youtube_captions (só vídeos do YouTube)
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLY_AI_API_KEY=
ASSEMBLY_AI_HTTP_TIMEOUT_SECONDS=900
# Idioma falado: pt_br | en | es | de ... Vazio = detecção automática.
TRANSCRIPTION_LANGUAGE=pt_br
WHISPER_MODEL_SIZE=medium


# -----------------------------------------------------------------------------
# [5] ANÁLISE POR LLM
# -----------------------------------------------------------------------------
# Formato: provider:modelo
#   google-gla:gemini-3-flash-preview   (precisa GOOGLE_API_KEY)
#   openai:gpt-5.2                      (precisa OPENAI_API_KEY)
#   anthropic:claude-4-sonnet           (precisa ANTHROPIC_API_KEY)
#   openrouter:anthropic/claude-sonnet-5.5 (precisa OPENROUTER_API_KEY + crédito)
#
# NOTA: a chave OpenRouter usada em desenvolvimento tinha limite de US$ 0,00
# e devolvia HTTP 403. Ver BACKLOG.md item 1.
LLM=google-gla:gemini-3-flash-preview
RERANK_LLM=

GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_FALLBACK_MODEL=
# Deixe vazio se não usar Ollama local. O serviço `ollama` NÃO está no
# docker-compose.dokploy.yml.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=


# -----------------------------------------------------------------------------
# [6] DOWNLOAD DO YOUTUBE
# -----------------------------------------------------------------------------
# yt_dlp (grátis, padrão) | apify (pago, com fallback para yt-dlp)
YOUTUBE_DOWNLOAD_PROVIDER=yt_dlp
YOUTUBE_METADATA_PROVIDER=yt_dlp
YOUTUBE_DATA_API_KEY=
APIFY_API_TOKEN=

# Cookies do yt-dlp — resolve falhas intermitentes de "Failed to download
# video" (bloqueio anti-bot). Ver BACKLOG.md item 2.
#
# Esta variável é LIDA pelo código (backend/src/youtube_utils.py) mas NÃO era
# exposta no docker-compose.yml original — ou seja, nunca chegava ao container.
# Ela É exposta no docker-compose.dokploy.yml.
#
# Duas formas de usar:
#   a) caminho para um arquivo de cookies dentro do container
#      (ex.: YOUTUBE_COOKIES_FILE=/app/uploads/cookies.txt, com o arquivo
#       colocado no volume `uploads`)
#   b) deixe vazio e coloque o arquivo em /app/uploads/cookies.txt —
#      o código detecta o caminho padrão sozinho
#
# Exporte os cookies do navegador em formato Netscape com uma extensão como
# "Get cookies.txt LOCALLY". Contém credenciais da sua conta Google:
# trate como segredo e nunca faça commit.
YOUTUBE_COOKIES_FILE=


# -----------------------------------------------------------------------------
# [7] LIMITES DE PROCESSAMENTO
# -----------------------------------------------------------------------------
MAX_VIDEO_DURATION=5400
PRO_YOUTUBE_MAX_VIDEO_DURATION=5400
SCALE_YOUTUBE_MAX_VIDEO_DURATION=10800
# ~12 GB. O limite no cliente do frontend precisa bater com este valor.
MAX_VIDEO_UPLOAD_BYTES=12000000000
QUEUED_TASK_TIMEOUT_SECONDS=180
DEFAULT_PROCESSING_MODE=fast
MAX_CLIPS=10
FAST_MODE_MAX_CLIPS=10
FAST_MODE_TRANSCRIPT_MODEL=universal
SPEAKER_FRAMING=true
HOOK_FIRST_TEASER=true

# A imagem do backend instala PyTorch CPU. Mantenha true em VPS sem GPU.
BACKEND_CPU_ONLY=true

# Plataforma do build. Deixe linux/amd64 em VPS x86 (o mais comum).
# Em VPS ARM (Hetzner ARM, Oracle Ampere, Graviton): linux/arm64.
BACKEND_PLATFORM=linux/amd64


# -----------------------------------------------------------------------------
# [8] ARMAZENAMENTO DE MÍDIA
# -----------------------------------------------------------------------------
# local = volumes Docker desta VPS | s3 = object storage
MEDIA_STORAGE=local
MEDIA_S3_BUCKET=
MEDIA_S3_PREFIX=media
MEDIA_S3_REGION=eu-central-1
MEDIA_S3_ENDPOINT=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SESSION_TOKEN=
MEDIA_URL_TTL_SECONDS=900
MEDIA_CACHE_TTL_SECONDS=86400
MEDIA_ORPHAN_GRACE_SECONDS=86400
MEDIA_UPLOAD_CONCURRENCY=3
MEDIA_UPLOAD_DAILY_LIMIT=20


# -----------------------------------------------------------------------------
# [9] EMAIL (opcional)
# -----------------------------------------------------------------------------
# Vazio = cadastro e login funcionam, mas "esqueci minha senha" e
# "verificar email" não enviam nada. Quem esquecer a senha fica preso.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL="SupoClip <onboarding@seudominio.com>"


# -----------------------------------------------------------------------------
# [10] PLANOS (sem monetização em SELF_HOST=true; mantidos por padrão)
# -----------------------------------------------------------------------------
FREE_PLAN_TASK_LIMIT=10
PRO_PLAN_TASK_LIMIT=50
SCALE_PLAN_TASK_LIMIT=300
NEXT_PUBLIC_FREE_PLAN_TASK_LIMIT=10
NEXT_PUBLIC_PRO_PLAN_TASK_LIMIT=50
NEXT_PUBLIC_SCALE_PLAN_TASK_LIMIT=300
NEXT_PUBLIC_PRO_PRICE_MONTHLY=10
NEXT_PUBLIC_SCALE_PRICE_MONTHLY=50


# -----------------------------------------------------------------------------
# [11] MCP (opcional)
# -----------------------------------------------------------------------------
# Se não for expor o MCP numa URL pública, deixe REQUIRE_BEARER_AUTH=true.
SUPOCLIP_API_URL=http://backend:8000
SUPOCLIP_MCP_TRANSPORT=sse
SUPOCLIP_MCP_PUBLIC_URL=
SUPOCLIP_MCP_REQUIRE_BEARER_AUTH=true
SUPOCLIP_TIMEOUT=60


# -----------------------------------------------------------------------------
# [12] ANALYTICS / FEEDBACK / PUBLICAÇÃO SOCIAL (opcional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
NEXT_PUBLIC_DATAFAST_DOMAIN=
NEXT_PUBLIC_DATAFAST_ALLOW_LOCALHOST=false

DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_SALES_WEBHOOK_URL=

# Redirect URI a registrar em cada plataforma:
#   ${NEXT_PUBLIC_APP_URL}/api/social/callback/<provider>
#   provider = youtube | tiktok | instagram
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
SOCIAL_OAUTH_REDIRECT_BASE_URL=
SOCIAL_PUBLIC_MEDIA_BASE_URL=
SOCIAL_METRICS_REFRESH_HOURS=6
SOCIAL_METRICS_MAX_POST_AGE_DAYS=60
SOCIAL_PERFORMANCE_MIN_POSTS=3
SOCIAL_PUBLISHING_ACCESS=all
SOCIAL_PUBLISHING_ALLOWED_EMAILS=
